<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Books</title>
</head>
<body>
    <% if(book_type !== 'All') { %>
        <h1>GET /books?book_type=<%= book_type %> - show all <%= book_type %> books</h1>
    <% } else { %>
        <h1>GET /books - show all books</h1>
    <% } %>
    <ul>
        <% for(const book of allBooks) { %>
            <li><a href="/books/<%= book._id %>"><%= book.name %></a></li>
        <% } %>
    </ul>
    <div style="display: flex; gap: 8px;">
        <a href="/books/new">
            New +
        </a>
        <% if(book_type !== 'All') { %>
            <a href="/books">All Books</a>
        <% } %>
    </div>
</body>
</html>