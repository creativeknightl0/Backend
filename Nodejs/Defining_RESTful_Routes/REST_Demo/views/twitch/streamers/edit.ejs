<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Twitch Streamer Record</title>
</head>
<body>
    <h1>PATCH /twitch/streamers/:id - to update the twitch streamer</h1>
    <form action="/twitch/streamers/<%= foundTwitchStreamer.id %>?_method=PATCH" method="POST" style="display: flex; flex-direction: column; align-items: start; gap: 8px;">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" value="<%= foundTwitchStreamer.username %>" />
        <label for="followers">Followers:</label>
        <input type="number" name="followers" id="followers" value="<%= foundTwitchStreamer.followers %>" />
        <label for="subs">Subscribers:</label>
        <input type="number" name="subscribers" id="subs" value="<%= foundTwitchStreamer.subscribers %>">
        <button>Submit</button>
    </form>
</body>
</html>