<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Books</title>
</head>
<body>
    <h1>GET /books - show all books</h1>
    <ul>
        <% for(const book of allBooks) { %>
            <li><a href="/books/<%= book._id %>"><%= book.name %></a></li>
        <% } %>
    </ul>
    <a href="/books/new">
        New +
    </a>
</body>
</html>